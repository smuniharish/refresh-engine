flowchart LR
    state["Current discovery and stored state"]
    discovered["Discovered resource"]
    observe["Observe by reliable indicator or snapshot"]
    compare["Compare observation with stored state"]
    classify(["Classify the change"])
    absent["Previously stored resource missing from discovery"]
    complete{"Discovery complete?"}
    deleted(["Treat as deleted"])
    kept(["Preserve; report warning"])

    state --> discovered --> observe --> compare --> classify
    state --> absent --> complete
    complete -- yes --> deleted
    complete -- no --> kept

    classDef outcome fill:#e8eaf6,stroke:#3949ab,color:#1a237e
    classDef question fill:#fff8e1,stroke:#f9a825,color:#4e342e
    classDef step fill:#ffffff,stroke:#5c6bc0,color:#1a237e
    class classify,deleted,kept outcome
    class complete question
    class state,discovered,observe,compare,absent step
